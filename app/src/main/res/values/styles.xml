<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.GirlPeriod.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/ghibli_matcha_accent</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Widget.GirlPeriod.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/ghibli_matcha_accent</item>
        <item name="android:textColor">@color/ghibli_matcha_accent</item>
    </style>
    <style name="Widget.GirlPeriod.EditText" parent="Widget.AppCompat.EditText">
        <item name="background">@drawable/bg_rounded_edittext</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/gray_medium</item>
    </style>
    <style name="Widget.GirlPeriod.Card" parent="">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="contentPadding">16dp</item>
    </style>
    <style name="TextAppearance.GirlPeriod.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.GirlPeriod.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.GirlPeriod.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
