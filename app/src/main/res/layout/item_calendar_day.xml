<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDayCell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:background="@drawable/bg_calendar_day_normal"
    android:padding="4dp">

    <!-- Day Number -->
    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lunar Date -->
    <TextView
        android:id="@+id/tvLunarDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="初六"
        android:textColor="@color/text_hint"
        android:textSize="9sp"
        app:layout_constraintTop_toBottomOf="@id/tvDayNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Weather Icon -->
    <ImageView
        android:id="@+id/ivWeatherIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_weather_sunny"
        app:tint="@color/primary_pink"
        app:layout_constraintTop_toBottomOf="@id/tvLunarDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicator Row -->
    <LinearLayout
        android:id="@+id/layoutIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ivWeatherIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- UV Indicator -->
        <View
            android:id="@+id/vIndicatorUV"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_indicator_uv" />

        <!-- Humidity Indicator -->
        <View
            android:id="@+id/vIndicatorHumidity"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_indicator_humidity" />

        <!-- Rainfall Indicator -->
        <View
            android:id="@+id/vIndicatorRainfall"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_indicator_rainfall" />

        <!-- Event Indicator -->
        <View
            android:id="@+id/vIndicatorEvent"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_indicator_event"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Period Highlight Overlay -->
    <View
        android:id="@+id/vPeriodHighlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_calendar_day_period"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Today Highlight Overlay -->
    <ImageView
        android:id="@+id/vTodayHighlight"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_long_cat"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Event Highlight Overlay -->
    <View
        android:id="@+id/vEventHighlight"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_calendar_event"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
